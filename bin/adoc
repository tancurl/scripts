#!/usr/bin/env ruby

require 'asciidoctor-pdf'
require 'asciidoctor/extensions'
require 'optparse'

# variables {{{

prompt = File.basename(__FILE__)
font = {
  share: "/usr/share/fonts/TTF",
  local: "/home/hos/.local/share/fonts",
}

# }}}

# helpers {{{

# print usage {{{

def print_usage
  puts "Convert asciidoc files to pdf using asiidoctor's ruby API"
  puts "                                                         "
  puts "Usage: #{prompt} --input input.adoc --output output.pdf  "
  puts "                                                         "
  puts "Options:                                                 "
  puts "        --input                                          "
  puts "        --output                                         "
  puts "        --type                                           "
  puts "        --config                                         "
  puts "        --language                                       "
  puts "        --type                                           "
  puts "        --style                                          "
  return
end

# }}}

# }}}

# == defaults == {{{
options = {
  backend: 'pdf',
  safe: :unsafe,
  doctype: :book,
  to_file: nil,
  attributes: {
    "chapter-label"          => "",
    "chapter-signifier"      => "",
    "toc"                    => nil,
    "skip-front-matter"      => true,
    "author"                 => "Hos Es",
    "icons"                  => "font",
    "icon-set"               => "fi",
    "table-stripes"          => "even",
    "title-page"             => false,
    "sectnums"               => true,
    "linenums"               => true,
    "h-def-list"             => true,
    "source-highlighter"     => "pygments",
    "pygments-style"         => "vs",  # xcode
    "pygments-linenums-mode" => "inline",
    "rouge-style"            => "github.light",
    "source-language"        => nil,
    "pdf-themedir"           => ".",
    "pdf-theme"              => nil,
  }
}

# highlighter = {
#   pygments: {
#     "pygments-style"         => "github-dark",
#     "pygments-linenums-mode" => "inline",
#   },
#   rouge: {
#     "rouge-style"  => "github.light",
#   }
# }
# if options[:attributes]["source-highlighter"] == "pygments"
# end

# }}}

# == CLI parsing == {{{

# === parsing === {{{
cli = {}
parser = OptionParser.new do |opts|
  opts.banner = "Usage: #{File.basename(__FILE__)} [options]"
  opts.on("-i", "--input FILE", "Input file (.adoc)")        { |v| cli[:input_file] = v }
  opts.on("-o", "--output FILE", "Output PDF")               { |v| cli[:output_file] = v }
  opts.on("--config FILE", "Config (theme) file")            { |v| cli[:theme_file] = v }
  opts.on("--language STYLE", "Source code block language")  { |v| cli[:doc_language] = v }
  opts.on("--doc-type TYPE", "Document type (article, book, inline)") do |v|
    options[:doctype] = v.to_sym
  end

  opts.on("--toc", "Enable TOC (left, right, or default left)") do
    options[:attributes]["toc"] = "left"  #  --toc default to "left"
  end

  opts.on("--no-toc", "Disable TOC") do
    options[:attributes]["toc"] = nil
  end


  # Map attributes
  options[:attributes].each do |key, default|
    flag = "--#{key.to_s.gsub('_','-')}"
    if [true, false].include?(default)
      # boolean flags: --flag / --no-flag
      opts.on(flag, "Enable #{key}") { options[:attributes][key] = true }
      opts.on("--no-#{key.to_s.gsub('_','-')}", "Disable #{key}") { options[:attributes][key] = false }
    else
      opts.on("#{flag} VALUE", String, "Set #{key} (default: #{default})") do |v|
        options[:attributes][key] = v
      end
    end
  end

  opts.on("-h", "--help", "Show this help") do
    puts opts
    exit
  end
end

parser.parse!
# }}}

# === validation === {{{
unless cli[:input_file]
  puts "#{prompt}: Error: Input file is missing"
  puts parser
  exit 1
end

input_file  = cli[:input_file]
output_file = cli[:output_file] || input_file.sub(/\.adoc$/, ".pdf")
theme_file  = cli[:theme_file]
# }}}

# === vertical / horizontal definition list === {{{
if options[:attributes]["h-def-list"]
  Asciidoctor::Extensions.register do
      treeprocessor do
          process do |doc_name|
              (doc_name.find_by context: :dlist).each do |dlist|
                  dlist.style = 'horizontal'
              end
              nil
          end
      end
  end
end
# }}}

# }}}

