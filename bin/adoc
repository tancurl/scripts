# == options == {{{

# === default fonts === {{{
font_main = fonts["FreeSans"]
font_title = fonts["FreeSerif"]
font_code = fonts["UbuntuMono"]
# }}}

# === defaults === {{{

options[:to_file] = output_file
options[:attributes]["pdf-theme"] = theme_file if theme_file
options[:attributes]["source-language"] = cli[:doc_language] if cli[:doc_language]
options[:attributes]["toc"] = 'left' if cli[:doc_language]
# }}}

# }}}

# == generate YAML theme content == {{{
theme_content = <<~YAML
  extends: default
  page:
    background-color: #{body_theme[:background]}
    size: a4paper
  font:
    catalog:
      Noto Serif:
        normal:      #{font_main[:normal]}
        bold:        #{font_main[:bold]}
        italic:      #{font_main[:italic]}
        bold_italic: #{font_main[:bold_italic]}
      M+ 1mn:
        normal:      #{font_code[:normal]}
        bold:        #{font_code[:bold]}
        italic:      #{font_code[:italic]}
        bold_italic: #{font_code[:bold_italic]}
      Title Sans:
        normal:      #{font_title[:normal]}
        bold:        #{font_title[:bold]}
        italic:      #{font_title[:italic]}
        bold_italic: #{font_title[:bold_italic]}
  base:
    font-color: #{body_theme[:text]}
    color: #{body_theme[:background]}
    font-size: #{options[:attributes]["font-size-main"]}
  link:
    font-color: #{body_theme[:link]}
    text-decoration-color: #{body_theme[:link]}
  caption:
    font-color: #{body_theme[:title]}
    font-size: #{options[:attributes]["font-size-caption"]}
    font-style: bold
  code:
    font-size: #{options[:attributes]["font-size-code"]}
    background-color: #{body_theme[:code_bg]}
    border-color: #{body_theme[:code_border]}
    font-color: #{body_theme[:text]}
  codespan:
    font-size: #{options[:attributes]["font-size-inlinecode"]}
    font-color: #{body_theme[:text]}
    border-color: #{body_theme[:border]}
    background-color: #{body_theme[:code_bg]}
YAML

if theme_file.nil?
  theme_file_path = Dir.pwd+'/asciidoctor-theme.yml'
else
  theme_file_path = theme_file
end

File.open(theme_file_path, 'w') do |file|
  file.write(theme_content)
end
# }}}

if File.exist?(input_file)
  if File.file?(input_file)
    puts "#{prompt}: converting #{input_file} to #{output_file}"
  else
    puts "#{prompt}: error: #{input_file} does not exists"
    exit 2
  end
else
  puts "#{prompt}: error: #{input_file} is not a valid candidate"
  exit 1
end

options[:attributes]["pdf-theme"] ||= theme_file_path
Asciidoctor.convert_file(
  input_file,
  safe: options[:safe],
  backend: options[:backend],
  doctype: options[:doctype],
  to_file: options[:to_file],
  attributes: options[:attributes]
)
File.delete(theme_file_path)
puts "#{prompt}: done"

