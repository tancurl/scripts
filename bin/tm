#!/usr/bin/env perl

package main;

use strict;
use warnings;
use IO::Handle;
use Getopt::Long; Getopt::Long::Configure("pass_through");
use File::Basename;

# variables
my $prompt = basename($0);

# flags
my $help = 0;
my $colorful = 0;
my $index = 1;
my $label;
my $dryrun = 0;
my $full_path_name = 1;

GetOptions(
    "h|help"     => \$help,
    "c|color"    => \$colorful,
    "dry-run"    => \$dryrun,
    "i|index=i"  => \$index,
    "n|name=s"   => \$label,
) or die "$prompt: invalid usage\n";

# help {{{
package help;

use POSIX qw(strftime);
use Term::ANSIColor;

# log {{{
sub log {
    my ($message, $level, $label) = @_;
    my ($package, $filename, $line) = caller();
    my $subname = (caller(0))[3];
    $filename = substr($filename, rindex($filename, '/') + 1);
    $label = $subname unless $label;

    my $current_date = strftime("%Y-%m-%d %H:%M:%S", localtime);
    my $log_name = "info";
    my $log_color = 'white';

    if ($level eq 2) {
        $log_name = "debug";
        $log_color = 'blue';
    } elsif ($level eq 3) {
        $log_name = "warn";
        $log_color = 'yellow';
    } elsif ($level eq 4) {
        $log_name = "error";
        $log_color = 'red';
    }

    my $msg;

    unless ($colorful) {
        $msg = sprintf("%s %s\n",
            # $current_date,
            # $prompt,
            # colored("$log_name", sprintf("%s %s", 'bold', $log_color)),
            $label,
            $message
        );
    } else {
        $msg = sprintf("%s %s\n",
            # $current_date,
            # $prompt,
            $label,
            $message
        );
    }

    if ($level) {
        if ($level eq 4) {
            die($msg);
        } elsif ($level eq 3) {
            warn($msg);
        } else {
            print($msg);
        }
    }
}
# }}}

# }}}

# tmux {{{
package tmux;

use Cwd qw(abs_path getcwd);

sub title {
    my ($arg) = @_;
    my $subname = (caller(0))[3];
    my $prefix = getpwuid($<) . '@' . `cat /etc/hostname`;
    chomp $prefix;
    my $path = defined $arg ? $arg : `pwd`;
    chomp $path;
    $path =~ s/\Q$ENV{HOME}\E/~/ if !defined $arg;
    if ($path eq ",") {
        $path = ".";
    }
    if ($path eq ".") {
        my @lex = split("/", getcwd());
        $path = "$lex[-2]/$lex[-1]";
    }
    if ($path eq "/") {
        $path = "root";
    }
    my $title = "[$prefix] tmux :: $path";
    $title = "tmux :: $path";
    $title =~ tr /\./_/;
    if ($dryrun) {
        help::log "$title", 2, $subname;
    } else {
        print "\033]0;$title\007";
    }
    STDOUT->flush();  # immediate output
    return $path;
}

sub convention {
    my ($name, $path) = @_;
    my $subname = (caller(0))[3];
    my @cmd;
    if ($name) {
        $path = abs_path($path);
    } else {
        help::log("No name provided", 4, $subname);
    }
    my @parts = split('/', $path);
    my $basename = pop @parts // '';
    my $dirname = pop @parts // '';
    $dirname = "root" if $dirname eq "/";
    $name = "$dirname/$basename";
    $name = $path if $full_path_name;
    $name = $label if $label;
    $name =~ tr/./_/;
    # ($path, $path) -> fullpath named session
    # ($name, $path) -> basename named session
    return ($name, $path);
}

sub create {
    my ($name, $path) = tmux::convention @_;
    my $subname = (caller(0))[3];
    my @cmd;
    unless (-d $path) {
        help::log("$path: not a directory", 4, $subname);
        # FEAT: make_path() can be added to create the directory
    }

    my $exists = 0;
    my @tmux_sessions = `tmux list-sessions 2>/dev/null`;
    chomp @tmux_sessions;
    foreach my $session (@tmux_sessions) {
        my $session_name = (split(":", $session))[0];
        if ($session_name eq $name) {
            $exists = 1;
            last;
        }
    }

    unless ($exists) {
        help::log("Created new tmux session: [$name :: $path]", 1, $subname);
        @cmd = (
            "tmux",
            "new-session",
            "-s", $name,
            "-c", $path,
            "-d",
        );
    } else {
        help::log("Session already exists: $name", 1, $subname);
    }
    if (@cmd) {
        if ($dryrun) {
            help::log "@cmd", 2, $subname;
        } else {
            system(@cmd);
        }
    }
}

sub attach {
    my ($name, $path) = convention @_;
    my $subname = (caller(0))[3];

    my @cmd;
    if (exists $ENV{"TMUX"}) {
        help::log("Switched to tmux session: $name", 1, $subname);
        if ($dryrun) {
            help::log("   path: $path", 2, $subname);
        }
        @cmd = (
            "tmux",
            "switch-client",
            "-t", $name,
        );
    } else {
        help::log("Attached to tmux session: $name", 1, $subname);
        if ($dryrun) {
            help::log("   path: $path", 2, $subname);
        }
        @cmd = (
            "tmux",
            "attach-session",
            "-t", $name,
        );
    }
    if ($dryrun) {
        help::log "@cmd", 2, $subname;
    } else {
        tmux::title($name);
        system(@cmd);
    }
}

sub run {
    # my @sessions = @_;
    my @sessions;
    my $count = scalar @sessions;

    if (@ARGV) {
        @sessions = @ARGV;
    } else {
        help::log("no path specified", 4);
    }

    foreach (@sessions) {
        my $name = $_;
        my $path = abs_path($_);
        tmux::create($name, $path);
    }
    my $init = shift @sessions;
    $init = "." if $init eq ",";
    my $initpath = abs_path($init);
    tmux::attach($init, $initpath);
}
# }}}

package main;

tmux::run()

