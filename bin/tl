@menu_options = map { @$_ } @fzf_options;
# @menu_options = sort @menu_options;

# helpers {{{
sub command {
    my ($program) = @_;
    my $path = $ENV{"PATH"};
    my @directories = split(":", $path);
    my $found = '';
    foreach my $dir (@directories) {
        my $full_path = "$dir/$program";
        if (-x $full_path) {
            $found = $full_path;
            last;
        }
    }
    return $found;
}
# }}}

$ENV{FZF_DEFAULT_OPTS} = "";
$ENV{FZF_DEFAULT_OPTS} = join " ", (
    $ENV{FZF_DEFAULT_OPTS},
    @menu_options,
);

# open(my $fh, ">", "cap.txt");
# printf $fh "%s\n", $ENV{FZF_DEFAULT_OPTS};
# close($fh);

# printf STDERR "%s\n\n\n", $ENV{FZF_DEFAULT_OPTS};

my $colorful = 1; # set 0 to disable colored logs

my $all = shift;
chomp $all if $all;

sub logger {
    my ($level, $message) = @_;
    my ($package, $filename, $line) = caller();
    $filename = substr($filename, rindex($filename, '/') + 1);

    my $current_date = strftime("%Y-%m-%d %H:%M:%S", localtime);
    my $log_name = "info";
    my $log_color = 'white';

    if ($level eq 2) {
        $log_name = "debug";
        $log_color = 'blue';
    } elsif ($level eq 3) {
        $log_name = "warn";
        $log_color = 'yellow';
    } elsif ($level eq 4) {
        $log_name = "error";
        $log_color = 'red';
    }

    my $msg;

    if ($colorful) {
        $msg = sprintf("%s %s %s %s\n",
            $current_date,
            $filename,
            colored("$log_name", sprintf("%s %s", 'bold', $log_color)),
            $message
        );
    } else {
        $msg = sprintf("%s %s %s\n",
            $current_date,
            $filename,
            $message
        );
    }

    if ($level) {
        if ($level eq 4) {
            die($msg);
        } elsif ($level eq 3) {
            die($msg);
        } else {
            die($msg);
        }
    }
}

sub set_title {
    unless ($ENV{SHELL} =~ /bash/) {
        my $title = shift;
        # print "\032]0;$title\007";
        print "\033]0;tmux :: $title\007";
        # print "\034]0;$title\007";
        # print "\035]0;$title\007";
        STDOUT->flush();  # immediate output
    }
}

sub tmux_sessionizer {
    my $fzf = command("fzf") // "";
    my @tmux_sessions = `tmux list-sessions 2>/dev/null`;
    chomp @tmux_sessions;

    if (!@tmux_sessions) {
        logger(4, "tmux: No active session(s)");
        exit 1;
    }

    my $session_list = join("\n", map { (split /:/)[0] } @tmux_sessions);
    # $session_list =~ s,$ENV{HOME},~,g;
    my $session_name = "";
    if ($fzf) {
        my $cmd = join(" ", (
                "echo '$session_list'", "|",
                $fzf,
            )
        );
        # logger 2, $cmd;
        # $cmd =~ s,^~,$ENV{HOME},g;
        $session_name = `$cmd`;
        chomp $session_name;
    } else {
        my @sessions = split /\n/, $session_list;

        for my $i (0 .. $#sessions) {
            printf "  %d) %s\n", $i + 1, $sessions[$i];
        }

        print "Select session [1-" . scalar(@sessions) . "]: ";
        chomp(my $choice = <STDIN>);

        if ($choice =~ /^\d+$/ && $choice >= 1 && $choice <= @sessions) {
            $session_name = $sessions[$choice - 1];
        } else {
            die "Invalid selection\n";
        }
    }
    
    if (!$session_name) {
        logger 3, "No session selected";
        exit 2;
    }

    set_title($session_name);
    if (!exists $ENV{"TMUX"}) {
        system "tmux attach -t '$session_name' 2>/dev/null";
        logger 0, "Attached to tmux session: $session_name";
    } else {
        system "tmux switchc -t '$session_name' 2>/dev/null";
        logger 0, "Switched to tmux session: $session_name";
    }

}

my $title = "list sessions";
set_title($title);

my @tmux_sessions = `tmux list-sessions 2>/dev/null`;
chomp @tmux_sessions;

if ($all) {
    if ($all =~ /^a/) {
        logger(1, "tmux: all session(s)");
        foreach my $tz (@tmux_sessions) {
            tmux_sessionizer(@tmux_sessions);
        }
    }
} else {
    tmux_sessionizer(@tmux_sessions);
}
